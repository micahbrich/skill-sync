#!/usr/bin/env bash
# skill-sync: keep every git repo under $SKILLS_HOME (default ~/skills) installed
# into every agent, and adopt skills that tools created outside any repo.
#
#   skill-sync                 pull, adopt strays, install, link profile
#   skill-sync status          what would change, without changing it
#   skill-sync hook <agent>    print the inbox note for claude|codex, then sync in the background
#   skill-sync clone <repo>…   git clone owner/repo into $SKILLS_HOME
#   skill-sync install         add the SessionStart hook to Claude Code
#
# A repo marks itself as the inbox with an empty .skill-sync-inbox file; adopted skills land in its skills/inbox/.
# Its .skill-sync-ignore lists glob patterns of skill names never to adopt (tool-generated skills that bypass the lock).
# A repo ships a machine profile as profile.md and its dependencies as dependencies.txt,
# one line per source: owner/repo --skill a --skill b. A bare owner/repo installs every skill in it.
set -euo pipefail

SKILLS_HOME="${SKILLS_HOME:-$HOME/skills}"
AGENTS="$HOME/.agents"
LOCK="$AGENTS/.skill-lock.json"
LOG="$AGENTS/skill-sync.log"
AGENT_DIRS=("$AGENTS/skills" "$HOME/.claude/skills" "$HOME/.codex/skills" "$HOME/.cursor/skills" "$HOME/.gemini/skills")
DRY=0

say()  { printf '%s\n' "$*"; }
note() { printf 'skill-sync: %s\n' "$*" >&2; }
run()  { if [ "$DRY" = 1 ]; then say "  would: $*"; else "$@"; fi; }

repos()   { for d in "$SKILLS_HOME"/*/; do [ -d "$d/.git" ] && printf '%s\n' "${d%/}"; done; }
inbox()   { for r in $(repos); do [ -e "$r/.skill-sync-inbox" ] && { printf '%s\n' "$r"; return; }; done; return 1; }
in_lock() { [ -f "$LOCK" ] && python3 -I -c 'import json,sys; sys.exit(0 if sys.argv[1] in json.load(open(sys.argv[2])).get("skills",{}) else 1)' "$1" "$LOCK"; }

ignored() {
  local box; box="$(inbox)" || return 1
  [ -f "$box/.skill-sync-ignore" ] || return 1
  while IFS= read -r pat; do
    [ -n "$pat" ] && [ "${pat#\#}" = "$pat" ] && [[ "$1" == $pat ]] && return 0
  done < "$box/.skill-sync-ignore"
  return 1
}

# A real directory with a SKILL.md that the skills CLI does not know about was made by hand.
strays() {
  for dir in "${AGENT_DIRS[@]}"; do
    [ -d "$dir" ] || continue
    for e in "$dir"/*/; do
      e="${e%/}"; n="$(basename "$e")"
      [ -L "$e" ] && continue
      [ -f "$e/SKILL.md" ] || continue
      [ "$n" = synced ] && continue
      in_lock "$n" && continue
      ignored "$n" && continue
      printf '%s\n' "$e"
    done
  done
}

# A stray with the same name as a repo skill is a leftover copy if the contents match. If it differs, its
# contents are parked under merge/<name>/<host>/ so the repo version can take its place without losing edits.
repo_copy() { local m; m="$(compgen -G "$SKILLS_HOME/*/skills/$1/SKILL.md" | head -1 || true)"; [ -n "$m" ] && dirname "$m"; return 0; }

pull() {
  for r in $(repos); do
    say "pull $(basename "$r")"
    run git -C "$r" pull --ff-only --quiet || note "pull failed in $r, keeping current checkout"
  done
}

adopt() {
  local box; box="$(inbox)" || { note "no repo has a .skill-sync-inbox marker, strays left alone"; return; }
  local moved=0
  while IFS= read -r e; do
    local n; n="$(basename "$e")"
    local existing; existing="$(repo_copy "$n")"
    if [ -n "$existing" ]; then
      if diff -rq "$e" "$existing" >/dev/null 2>&1; then say "drop $n  (identical copy of $existing)"; run rm -rf "$e"
      else
        say "park $n  (differs from $existing; copy kept in merge/$n/$(hostname -s))"
        run mkdir -p "$box/merge/$n/$(hostname -s)"
        run cp -R "$e/." "$box/merge/$n/$(hostname -s)/"
        [ -f "$box/merge/$n/$(hostname -s)/SKILL.md" ] && run mv "$box/merge/$n/$(hostname -s)/SKILL.md" "$box/merge/$n/$(hostname -s)/SKILL.variant.md"
        moved=1
      fi
      continue
    fi
    if [ -e "$box/skills/inbox/$n" ]; then note "stray $e clashes with inbox/$n, left in place"; continue; fi
    say "adopt $n  ($e)"
    run mkdir -p "$box/skills/inbox"
    run mv "$e" "$box/skills/inbox/$n"
    run rm -rf "$box/skills/inbox/$n/.git"
    moved=1
  done < <(strays)
  if [ "$moved" = 1 ] && [ "$DRY" = 0 ]; then
    git -C "$box" add skills/inbox merge
    git -C "$box" commit --quiet -m "Adopt skills from $(hostname -s)" || true
    git -C "$box" push --quiet || note "push failed, adoption is committed locally"
  fi
}

install_skills() {
  for r in $(repos); do
    if compgen -G "$r/skills/*/SKILL.md" >/dev/null || compgen -G "$r/plugins/*/skills/*/SKILL.md" >/dev/null; then
      say "install $(basename "$r")"
      run npx -y skills add "$r" --skill '*' -g -y >/dev/null </dev/null || note "install of $r reported errors"
    fi
    if [ -f "$r/dependencies.txt" ]; then
      while IFS= read -r src; do
        say "install dependency $src"
        # shellcheck disable=SC2086  # a line is "owner/repo --skill a --skill b", split on purpose
        run npx -y skills add $src -g -y >/dev/null </dev/null || note "install of $src reported errors"
      done < <(grep -v '^[[:space:]]*\(#\|$\)' "$r/dependencies.txt" || true)
    fi
  done
  say "update dependencies"
  run npx -y skills update -g -y >/dev/null </dev/null || note "update reported errors"
}

# A company repo's profile wins over the inbox repo's, so a shared default can ship in the inbox.
link_profile() {
  local chosen="" box; box="$(inbox)" || box=""
  for r in $(repos); do
    [ -f "$r/profile.md" ] || continue
    if [ -z "$chosen" ] || [ "$(dirname "$chosen")" = "$box" ]; then chosen="$r/profile.md"; fi
  done
  [ -n "$chosen" ] || return 0
  say "profile -> $chosen"
  run mkdir -p "$AGENTS"
  run ln -sfn "$chosen" "$AGENTS/profile.md"
}

inbox_note() {
  local box; box="$(inbox)" || return 0
  local names; names="$(ls "$box/skills/inbox" 2>/dev/null | tr '\n' ' ' | sed 's/ *$//')"
  [ -n "$names" ] || return 0
  printf 'skill-sync: unfiled skills in %s/skills/inbox: %s. Read the README.md of each repo under %s and move each skill into the repo whose README fits (git mv, commit, push). A skill that fits none moves to skills/ in the inbox repo.' \
    "$(basename "$box")" "$names" "$SKILLS_HOME"
}

sync_all() { pull; install_skills; adopt; link_profile; }

cmd="${1:-sync}"; shift || true
case "$cmd" in
  sync)   sync_all ;;
  status) DRY=1; sync_all; say "strays:"; strays | sed 's/^/  /' ;;
  hook)
    agent="${1:?hook needs an agent: claude|codex}"
    msg="$(inbox_note)"
    case "$agent" in
      claude) [ -n "$msg" ] && say "$msg" ;;
      codex)  python3 -I -c 'import json,sys; print(json.dumps({"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":sys.argv[1]}}))' "$msg" ;;
    esac
    mkdir -p "$AGENTS"
    (nohup "$0" sync >>"$LOG" 2>&1 &) ;;
  clone)
    mkdir -p "$SKILLS_HOME"
    for r in "$@"; do run git clone --quiet "https://github.com/$r.git" "$SKILLS_HOME/$(basename "$r")"; done ;;
  install)
    python3 -I - "$HOME/.claude/settings.json" "$0" <<'PY'
import json, sys, os
path, me = sys.argv[1], sys.argv[2]
s = json.load(open(path)) if os.path.exists(path) else {}
entry = {"type": "command", "command": f"{me} hook claude"}
starts = s.setdefault("hooks", {}).setdefault("SessionStart", [])
if not any(h.get("command") == entry["command"] for m in starts for h in m.get("hooks", [])):
    starts.append({"matcher": "startup", "hooks": [entry]})
    json.dump(s, open(path, "w"), indent=2)
    print("added SessionStart hook to", path)
else:
    print("hook already present in", path)
PY
    say "for Codex, add a SessionStart hook running: $0 hook codex" ;;
  *) sed -n '2,12p' "$0"; exit 1 ;;
esac
